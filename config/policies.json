{
  "policies": [
    {
      "handler": {
        "export": "Auth0JwtInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "allowUnauthenticatedRequests": false,
          "audience": "https://apiaurora",
          "auth0Domain": "aurorajk.us.auth0.com",
          "oAuthResourceMetadataEnabled": false
        }
      },
      "name": "auth0-jwt-auth",
      "policyType": "auth0-jwt-auth-inbound"
    },
    {
      "handler": {
        "export": "SetHeadersInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "headers": [
            {
              "name": "x-zuplo-secret",
              "value": "$env(BACKEND_SECRET)"
            }
          ]
        }
      },
      "name": "x-zuplo-secret",
      "policyType": "set-headers-inbound"
    },
    {
  "handler": {
    "export": "CorsInboundPolicy",
    "module": "$import(@zuplo/runtime)",
    "options": {
      "allowOrigin": ["https://aurora-frontend-1a7.pages.dev"]
    }
  },
  "name": "cors-policy",
  "policyType": "cors-inbound"
}
  ]
}